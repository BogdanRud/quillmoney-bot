# Скопируйте в .env и заполните значения
BOT_TOKEN=your_bot_token_here
OWNER_TELEGRAM_ID=your_telegram_id
BOT_OWNERS=@your_telegram_username
JWT_SECRET_KEY=generate_with_python_secrets_token_urlsafe_48
REFERRAL_BONUS=0.30
SUBSCRIPTION_CHECK_INTERVAL_HOURS=6
BROADCAST_DELAY_SECONDS=0.05
MIN_WITHDRAWAL=25
SUBSCRIPTION_HOLD_DAYS=7
# ВАЖНО: в продакшене используйте https:// и домен, а не голый IP
WEB_ADMIN_URL=https://your-domain.example/admin
# Включите при HTTPS (обязательно в продакшене)
COOKIE_SECURE=true
# Домены, с которых разрешён CORS к веб-панели (через запятую). Пусто = CORS отключён.
ALLOWED_ORIGINS=
# IP, которым разрешён доступ к веб-панели (через запятую). Рекомендуется
# указать ваш домашний/офисный IP. Пусто = ограничение отключено.
ADMIN_IP_WHITELIST=
# Сколько живёт сессия в веб-панели, минут (по умолчанию 120)
ACCESS_TOKEN_EXPIRE_MINUTES=120
# На каком интерфейсе слушает веб-панель. YOUR_SERVER_IP = только локально, доступ
# снаружи только через Nginx (см. deploy/). YOUR_SERVER_IP — напрямую наружу, НЕ
# рекомендуется (так и был скомпрометирован токен — открытый HTTP без proxy).
WEB_ADMIN_HOST=YOUR_SERVER_IP
WEB_ADMIN_PORT=8000